{
  "name": "dsh-billing-capsule",
  "version": "0.2.0",
  "description": "Session billing pill for DeepSeek Harness: shows what the current session cost, priced with the official per-model peak/idle rates.",
  "license": "MIT",
  "author": "Ricardo (https://github.com/CKLYZZQ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CKLYZZQ/DSH-plugin-Billing-Capsule.git"
  },
  "homepage": "https://github.com/CKLYZZQ/DSH-plugin-Billing-Capsule#readme",
  "bugs": {
    "url": "https://github.com/CKLYZZQ/DSH-plugin-Billing-Capsule/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "billing",
    "cost",
    "token",
    "usage",
    "pricing"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "pricing.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "meta": {
    "title": "会话账单",
    "description": "在输入框底栏显示当前会话按官方单价折算的花费，可展开逐轮明细。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
